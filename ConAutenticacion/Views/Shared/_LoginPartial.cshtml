@if (Request.IsAuthenticated)
{
    using (Html.BeginForm("LogOff", "Account", FormMethod.Post, new { id = "formSalir", @class = "d-flex align-items-center" }))
    {
        @Html.AntiForgeryToken()
        <span class="text-white me-3">Hola, @User.Identity.GetUserName()</span>
        <button type="submit" class="btn btn-outline-light btn-sm">Salir</button>
    }
}
else
{
    <div class="d-flex">
        <a class="btn btn-outline-light btn-sm me-2" href="@Url.Action("Login", "Account")">Iniciar sesion</a>
        <a class="btn btn-warning btn-sm" href="@Url.Action("Register", "Account")">Registrarse</a>
    </div>
}
