        <h1 id="title">@ViewBag.Title.</h1>
    </hgroup>
    <div>
        <p>
            Se restablecio la contrasena. @Html.ActionLink("Haga clic aqui para iniciar sesion", "Login", "Account", routeValues: null, htmlAttributes: new { id = "loginLink" })
        </p>
    </div>
</main>
