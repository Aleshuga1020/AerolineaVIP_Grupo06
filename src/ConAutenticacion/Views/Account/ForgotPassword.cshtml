@model ConAutenticacion.Models.ForgotPasswordViewModel
@{
    ViewBag.Title = "Recuperar contraseña";
}

<div class="row justify-content-center py-4">
    <div class="col-md-7 col-lg-5">
        <div class="card shadow-sm border-0">
            <div class="card-header barra text-white text-center py-3">
                <h2 class="h4 mb-0">Recuperación de contraseña</h2>
            </div>

            <div class="card-body p-4">
                <p class="text-muted small mb-4">
                    Ingrese el correo electrónico asociado a su cuenta y le enviaremos las instrucciones para restablecer su contraseña.
                </p>

                @using (Html.BeginForm("ForgotPassword", "Account", FormMethod.Post, new { role = "form", novalidate = "novalidate" }))
                {
                    @Html.AntiForgeryToken()
                    @Html.ValidationSummary(true, "", new { @class = "alert alert-danger py-2 small" })

                    <div class="mb-4">
                        @Html.LabelFor(m => m.Email, "Correo electrónico", new { @class = "form-label fw-semibold" })
                        @Html.TextBoxFor(m => m.Email, new { @class = "form-control", type = "email", placeholder = "usuario@ejemplo.com", autofocus = "autofocus" })
                        @Html.ValidationMessageFor(m => m.Email, "", new { @class = "text-danger small" })
                    </div>

                    <div class="d-grid gap-2">
                        <button type="submit" class="btn btn-primary py-2 fw-semibold">
                            Enviar enlace de recuperación
                        </button>
                        @Html.ActionLink("Volver al inicio de sesión", "Login", "Account", null, new { @class = "btn btn-outline-secondary" })
                    </div>
                }
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @Scripts.Render("~/bundles/jqueryval")
}
