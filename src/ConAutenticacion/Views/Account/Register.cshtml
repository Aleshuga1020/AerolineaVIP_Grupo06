@model ConAutenticacion.Models.RegisterViewModel
@{
    ViewBag.Title = "Crear cuenta";
    bool esSuper = User.Identity.IsAuthenticated && User.IsInRole("SuperUsuario");
}

<div class="row justify-content-center py-4">
    <div class="col-md-10 col-lg-7">
        <div class="card shadow-sm border-0">
            <div class="card-header barra text-white py-3">
                <h2 class="h4 mb-0">Registro de usuario - Aerolínea VIP</h2>
            </div>

            <div class="card-body p-4">
                <p class="text-muted small mb-4">
                    Complete sus datos personales y credenciales para gestionar reservas, pagos y check-in en línea.
                </p>

                @using (Html.BeginForm("Register", "Account", FormMethod.Post, new { role = "form", novalidate = "novalidate" }))
                {
                    @Html.AntiForgeryToken()
                    @Html.ValidationSummary(true, "", new { @class = "alert alert-danger py-2 small" })

                    <div class="row g-3">
                        <div class="col-md-6">
                            @Html.LabelFor(m => m.Nombres, new { @class = "form-label fw-semibold" })
                            @Html.TextBoxFor(m => m.Nombres, new { @class = "form-control", placeholder = "Ej. Mariana Isabel" })
                            @Html.ValidationMessageFor(m => m.Nombres, "", new { @class = "text-danger small" })
                        </div>

                        <div class="col-md-6">
                            @Html.LabelFor(m => m.Apellidos, new { @class = "form-label fw-semibold" })
                            @Html.TextBoxFor(m => m.Apellidos, new { @class = "form-control", placeholder = "Ej. Cevallos Ortiz" })
                            @Html.ValidationMessageFor(m => m.Apellidos, "", new { @class = "text-danger small" })
                        </div>

                        <div class="col-md-6">
                            @Html.LabelFor(m => m.Email, "Correo electrónico", new { @class = "form-label fw-semibold" })
                            @Html.TextBoxFor(m => m.Email, new { @class = "form-control", type = "email", placeholder = "correo@ejemplo.com" })
                            @Html.ValidationMessageFor(m => m.Email, "", new { @class = "text-danger small" })
                        </div>

                        <div class="col-md-6">
                            @Html.LabelFor(m => m.UserName, "Nombre de usuario", new { @class = "form-label fw-semibold" })
                            @Html.TextBoxFor(m => m.UserName, new { @class = "form-control", placeholder = "Ej. cliente01" })
                            @Html.ValidationMessageFor(m => m.UserName, "", new { @class = "text-danger small" })
                        </div>

                        <div class="col-md-6">
                            @Html.LabelFor(m => m.Password, "Contraseña", new { @class = "form-label fw-semibold" })
                            @Html.PasswordFor(m => m.Password, new { @class = "form-control", placeholder = "Mínimo 8 caracteres" })
                            @Html.ValidationMessageFor(m => m.Password, "", new { @class = "text-danger small" })
                            <div class="form-text">Debe incluir mayúscula, minúscula, número y símbolo.</div>
                        </div>

                        <div class="col-md-6">
                            @Html.LabelFor(m => m.ConfirmPassword, "Confirmar contraseña", new { @class = "form-label fw-semibold" })
                            @Html.PasswordFor(m => m.ConfirmPassword, new { @class = "form-control", placeholder = "Repita su contraseña" })
                            @Html.ValidationMessageFor(m => m.ConfirmPassword, "", new { @class = "text-danger small" })
                        </div>

                        @if (esSuper)
                        {
                            <div class="col-12">
                                @Html.LabelFor(m => m.Rol, new { @class = "form-label fw-semibold" })
                                @Html.DropDownListFor(m => m.Rol, new SelectList(new[] { "Cliente", "Administrador" }), new { @class = "form-select" })
                                @Html.ValidationMessageFor(m => m.Rol, "", new { @class = "text-danger small" })
                            </div>
                        }

                        <div class="col-12 mt-3">
                            <div class="form-check">
                                @Html.CheckBoxFor(m => m.AceptaCondiciones, new { @class = "form-check-input" })
                                @Html.LabelFor(m => m.AceptaCondiciones, "Acepto los términos, condiciones de transporte y política de privacidad de Aerolínea VIP", new { @class = "form-check-label" })
                            </div>
                            @Html.ValidationMessageFor(m => m.AceptaCondiciones, "", new { @class = "text-danger small d-block" })
                        </div>
                    </div>

                    <div class="d-grid mt-4">
                        <button type="submit" class="btn btn-primary py-2 fw-semibold">
                            Completar registro
                        </button>
                    </div>
                }
            </div>

            <div class="card-footer bg-light text-center py-3">
                <span class="text-muted">¿Ya tienes una cuenta?</span>
                @Html.ActionLink("Inicia sesión aquí", "Login", "Account", null, new { @class = "fw-semibold text-decoration-none ms-1" })
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @Scripts.Render("~/bundles/jqueryval")
}
