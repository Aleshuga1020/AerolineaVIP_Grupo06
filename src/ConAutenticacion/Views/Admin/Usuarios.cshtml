@model List<ConAutenticacion.Models.GestionUsuarioVM>
@{
    ViewBag.Title = "Usuarios y pasajeros";
    bool esSuper = User.IsInRole("SuperUsuario");
    var pasajeros = (List<ConAutenticacion.Models.Pasajero>)ViewBag.Pasajeros;
}

@if (TempData["Mensaje"] != null)
{
    <div class="alert alert-success">@TempData["Mensaje"]</div>
}
@if (TempData["Error"] != null)
{
    <div class="alert alert-danger">@TempData["Error"]</div>
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h2 class="mb-0">Usuarios</h2>
    @Html.ActionLink("Crear usuario", "CrearUsuario", "Admin", null, new { @class = "btn btn-primary" })
</div>

<div class="table-responsive mb-4">
    <table class="table table-sm align-middle">
        <thead>
            <tr>
                <th>Usuario</th>
                <th>Nombre</th>
                <th>Correo</th>
                <th>Roles</th>
                @if (esSuper)
                {
                    <th>Asignar o quitar rol</th>
                }
                <th>Acciones</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var u in Model)
            {
                <tr>
                    <td>@u.UserName</td>
                    <td>@u.Nombres @u.Apellidos</td>
                    <td>@u.Email</td>
                    <td>@u.Roles</td>
                    @if (esSuper)
                    {
                        <td>
                            @using (Html.BeginForm("CambiarRol", "Admin", FormMethod.Post, new { @class = "d-flex gap-2" }))
                            {
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="userId" value="@u.Id" />
                                <select name="rol" class="form-select form-select-sm">
                                    <option value="Cliente">Cliente</option>
                                    <option value="Administrador">Administrador</option>
                                    <option value="Counter">Counter</option>
                                </select>
                                <button type="submit" name="asignar" value="true" class="btn btn-sm btn-outline-primary">Asignar</button>
                                <button type="submit" name="asignar" value="false" class="btn btn-sm btn-outline-danger">Quitar</button>
                            }
                        </td>
                    }
                    <td class="text-nowrap">
                        @if (esSuper || !u.Roles.Contains("SuperUsuario"))
                        {
                            @Html.ActionLink("Editar", "EditarUsuario", "Admin", new { id = u.Id }, new { @class = "btn btn-sm btn-outline-secondary" })
                            @if (u.UserName != User.Identity.Name)
                            {
                                @using (Html.BeginForm("EliminarUsuario", "Admin", FormMethod.Post, new { @class = "d-inline", onsubmit = "return confirm('Eliminar este usuario? Esta accion no se puede deshacer.');" }))
                                {
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="id" value="@u.Id" />
                                    <button type="submit" class="btn btn-sm btn-outline-danger">Eliminar</button>
                                }
                            }
                        }
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>

@if (esSuper)
{
    <p>@Html.ActionLink("Registrar un nuevo usuario", "Register", "Account")</p>
}

<h2>Pasajeros</h2>
@if (pasajeros == null || !pasajeros.Any())
{
    <p class="text-muted">No hay pasajeros registrados.</p>
}
else
{
    <div class="table-responsive">
        <table class="table table-sm">
            <thead>
                <tr>
                    <th>Documento</th>
                    <th>Numero</th>
                    <th>Nombres</th>
                    <th>Apellidos</th>
                    <th>Correo</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var p in pasajeros)
                {
                    <tr>
                        <td>@p.TipoDocumentoCodigo</td>
                        <td>@p.NumeroDocumento</td>
                        <td>@p.Nombres</td>
                        <td>@p.Apellidos</td>
                        <td>@p.Correo</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}
