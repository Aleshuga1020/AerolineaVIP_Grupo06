@model ConAutenticacion.Models.EditarUsuarioVM
@{
    ViewBag.Title = "Editar usuario";
}

<h2>Editar usuario</h2>
<p class="text-muted">Usuario: <strong>@Model.UserName</strong></p>

@using (Html.BeginForm("EditarUsuario", "Admin", FormMethod.Post, new { @class = "row g-3 col-lg-8" }))
{
    @Html.AntiForgeryToken()
    @Html.HiddenFor(m => m.Id)
    @Html.ValidationSummary(true, "", new { @class = "alert alert-danger" })

    <div class="col-md-6">
        @Html.LabelFor(m => m.Nombres, new { @class = "form-label" })
        @Html.TextBoxFor(m => m.Nombres, new { @class = "form-control" })
        @Html.ValidationMessageFor(m => m.Nombres, "", new { @class = "text-danger small" })
    </div>
    <div class="col-md-6">
        @Html.LabelFor(m => m.Apellidos, new { @class = "form-label" })
        @Html.TextBoxFor(m => m.Apellidos, new { @class = "form-control" })
        @Html.ValidationMessageFor(m => m.Apellidos, "", new { @class = "text-danger small" })
    </div>
    <div class="col-12">
        @Html.LabelFor(m => m.Email, new { @class = "form-label" })
        @Html.TextBoxFor(m => m.Email, new { @class = "form-control", type = "email" })
        @Html.ValidationMessageFor(m => m.Email, "", new { @class = "text-danger small" })
    </div>

    <div class="col-12 mt-3">
        <button type="submit" class="btn btn-primary">Guardar cambios</button>
        @Html.ActionLink("Cancelar", "Usuarios", "Admin", null, new { @class = "btn btn-link" })
    </div>
}
