@model ConAutenticacion.Models.Compra
@{
    ViewBag.Title = "Pago simulado";
    var detalle = (ConAutenticacion.Models.ReservaDetalleVM)ViewBag.Detalle;
    var metodos = (List<ConAutenticacion.Models.MetodoPago>)ViewBag.Metodos;
    var marcas = (List<ConAutenticacion.Models.MarcaTarjeta>)ViewBag.Marcas;
}

<h2>Pago de la reserva @detalle.Reserva.CodigoReserva</h2>

<div class="alert alert-warning small">
    Pago simulado con fines academicos. No se realiza ningun cobro real. Una tarjeta cuyo numero termina en <strong>0000</strong> sera rechazada.
</div>

<div class="row g-4">
    <div class="col-lg-5">
        <div class="card card-body">
            <h5>Resumen</h5>
            <p class="mb-1">Asientos: @detalle.Asientos.Count</p>
            <p class="totales mb-0">Total: USD @Model.Importe.ToString("0.00")</p>
        </div>
    </div>

    <div class="col-lg-7">
        @using (Html.BeginForm("ProcesarPago", "Compras", FormMethod.Post, new { id = "formPago" }))
        {
            @Html.AntiForgeryToken()
            <input type="hidden" name="compraId" value="@Model.CompraId" />

            <div class="row g-3">
                <div class="col-md-6">
                    <label class="form-label" for="metodoPagoCodigo">Metodo de pago</label>
                    @Html.DropDownList("metodoPagoCodigo", new SelectList(metodos, "Codigo", "Nombre"), new { @class = "form-select", id = "metodoPagoCodigo", required = "required" })
                </div>
                <div class="col-md-6">
                    <label class="form-label" for="marcaTarjetaCodigo">Marca</label>
                    @Html.DropDownList("marcaTarjetaCodigo", new SelectList(marcas, "Codigo", "Nombre"), new { @class = "form-select", id = "marcaTarjetaCodigo", required = "required" })
                </div>
                <div class="col-12">
                    <label class="form-label" for="numeroTarjeta">Numero de tarjeta</label>
                    <input type="text" name="numeroTarjeta" id="numeroTarjeta" class="form-control" inputmode="numeric" maxlength="16" autocomplete="off" data-solo-digitos="true" required />
                    <div class="form-text">Visa y MasterCard: 16 digitos | AMEX: 15 | Diners: 14.</div>
                </div>
                <div class="col-12">
                    <label class="form-label" for="titular">Titular</label>
                    <input type="text" name="titular" id="titular" class="form-control" maxlength="100" required />
                </div>
                <div class="col-md-6">
                    <label class="form-label" for="vencimiento">Vencimiento (MM/AA)</label>
                    <input type="text" name="vencimiento" id="vencimiento" class="form-control" placeholder="MM/AA" maxlength="5" pattern="(0[1-9]|1[0-2])/\d{2}" required />
                </div>
                <div class="col-md-6">
                    <label class="form-label" for="codigoSeguridad">Codigo de seguridad</label>
                    <input type="password" name="codigoSeguridad" id="codigoSeguridad" class="form-control" inputmode="numeric" maxlength="4" autocomplete="off" data-solo-digitos="true" required />
                    <div class="form-text">3 digitos (4 en AMEX).</div>
                </div>
            </div>

            <button type="button" id="btnPagar" class="btn btn-primary mt-3">Pagar</button>
            @Html.ActionLink("Volver", "Gestionar", "ReservasCliente", new { reservaId = detalle.Reserva.ReservaId }, new { @class = "btn btn-link mt-3" })
        }

        <div class="modal fade" id="modalConfirmarPago" tabindex="-1" aria-labelledby="modalConfirmarPagoLabel" aria-hidden="true">
            <div class="modal-dialog modal-dialog-centered">
                <div class="modal-content">
                    <div class="modal-header">
                        <h5 class="modal-title" id="modalConfirmarPagoLabel">Confirmar pago</h5>
                        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Cerrar"></button>
                    </div>
                    <div class="modal-body">
                        <p class="mb-2">Va a pagar la reserva <strong>@detalle.Reserva.CodigoReserva</strong> por <strong>USD @Model.Importe.ToString("0.00")</strong>.</p>
                        <p class="small text-muted mb-0">Es un pago simulado. Revise los datos de la tarjeta antes de continuar.</p>
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Revisar datos</button>
                        <button type="submit" form="formPago" class="btn btn-primary">Confirmar pago</button>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section scripts {
    <script>
        document.getElementById('btnPagar').addEventListener('click', function () {
            var formulario = document.getElementById('formPago');
            if (formulario.reportValidity()) {
                bootstrap.Modal.getOrCreateInstance(document.getElementById('modalConfirmarPago')).show();
            }
        });
    </script>
}
