@{
    ViewBag.Title = "Mostrador (Counter)";
}

<div class="row justify-content-center py-4">
    <div class="col-md-8 col-lg-6">
        <div class="card shadow-sm border-0">
            <div class="card-header barra text-white py-3">
                <h2 class="h4 mb-0">Atención en Mostrador (Counter)</h2>
            </div>

            <div class="card-body p-4">
                <p class="text-muted small mb-4">
                    Consulte el estado operativo, titular, pagos y asignación de asientos de cualquier reserva mediante su código único.
                </p>

                @if (ViewBag.Error != null)
                {
                    <div class="alert alert-danger py-2">
                        @ViewBag.Error
                    </div>
                }

                @using (Html.BeginForm("BuscarReserva", "Counter", FormMethod.Post, new { role = "form" }))
                {
                    @Html.AntiForgeryToken()

                    <div class="mb-4">
                        <label for="codigoReserva" class="form-label fw-semibold">Código de Reserva</label>
                        <input type="text"
                               name="codigoReserva"
                               id="codigoReserva"
                               class="form-control form-control-lg text-uppercase"
                               placeholder="Ej. RV00000001"
                               pattern="[Rr][Vv]\d{8}"
                               maxlength="10"
                               autofocus
                               required />
                        <div class="form-text">Formato requerido: RV seguido de 8 dígitos numéricos.</div>
                    </div>

                    <div class="d-grid gap-2">
                        <button type="submit" class="btn btn-primary py-2 fw-semibold">
                            Consultar Reserva en Sistema
                        </button>
                        @Html.ActionLink("Volver al panel de administración", "Index", "Admin", null, new { @class = "btn btn-outline-secondary" })
                    </div>
                }
            </div>
        </div>
    </div>
</div>

