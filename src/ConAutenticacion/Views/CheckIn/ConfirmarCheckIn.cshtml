@model List<ConAutenticacion.Models.CheckInItemVM>
@{
    ViewBag.Title = "Confirmar check-in";
    bool hayElegibles = Model.Any(i => i.Elegible);
}

<h2 class="mb-3">Check-in de la reserva @ViewBag.Codigo</h2>

<div class="alert alert-secondary small">
    <strong>Política de Check-in:</strong> El registro de check-in se habilita únicamente desde <strong>48 horas antes</strong> hasta <strong>1 hora antes</strong> de la salida programada del vuelo y requiere que la reserva esté pagada.
</div>

<div class="card shadow-sm border-0 mb-4">
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th class="text-center" style="width: 50px;">Sel.</th>
                        <th>Pasajero</th>
                        <th>Vuelo</th>
                        <th>Ruta y Salida Programada</th>
                        <th>Asiento</th>
                        <th>Estado /Disponibilidad</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var i in Model)
                    {
                        <tr>
                            <td class="text-center">
                                @if (i.Elegible)
                                {
                                    <input type="checkbox" name="asignacionesSeleccionadas" value="@i.AsignacionId" class="form-check-input" form="formCheckIn" checked />
                                }
                                else
                                {
                                    <input type="checkbox" class="form-check-input" disabled />
                                }
                            </td>
                            <td>
                                <span class="fw-semibold">@i.Pasajero</span>
                                <span class="small text-muted d-block">Doc: @i.Documento</span>
                            </td>
                            <td><span class="badge bg-primary">@i.Vuelo</span></td>
                            <td>@i.Ruta</td>
                            <td><span class="badge bg-dark">@i.Asiento</span></td>
                            <td>
                                @if (i.Elegible)
                                {
                                    <span class="badge bg-success">Listo para check-in</span>
                                }
                                else if (i.YaRegistrado)
                                {
                                    <span class="badge bg-info text-dark">@i.Motivo</span>
                                }
                                else
                                {
                                    <span class="text-danger fw-semibold small">@i.Motivo</span>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

@using (Html.BeginForm("ProcesarCheckIn", "CheckIn", FormMethod.Post, new { id = "formCheckIn", @class = "card card-body shadow-sm border-0 mb-3" }))
{
    @Html.AntiForgeryToken()
    <div class="form-check mb-3">
        <input type="checkbox" name="confirmaEquipaje" value="true" id="confirmaEquipaje" class="form-check-input" @(hayElegibles ? "" : "disabled") required />
        <input type="hidden" name="confirmaEquipaje" value="false" />
        <label class="form-check-label" for="confirmaEquipaje">
            Confirmo que mi equipaje de mano cumple las normas de seguridad y acepto las condiciones de viaje.
        </label>
    </div>

    @if (!hayElegibles)
    {
        <div class="alert alert-warning mb-3">
            No es posible realizar el check-in en este momento para los tramos mostrados. Verifique el motivo en la columna de estado (recuerde que el check-in solo está habilitado entre 48h y 1h antes del vuelo).
        </div>
    }

    <div>
        <button type="submit" class="btn btn-primary px-4" @(hayElegibles ? "" : "disabled")>
            Registrar check-in
        </button>
        @Html.ActionLink("Buscar otra reserva", "Index", "CheckIn", null, new { @class = "btn btn-outline-secondary ms-2" })
    </div>
}
